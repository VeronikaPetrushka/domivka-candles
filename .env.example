# Optional order webhook used by the checkout form
VITE_ORDER_ENDPOINT=

# Persistent catalogue API. Run `npm run api` locally and set:
VITE_CATALOG_API_URL=http://localhost:8787/api

# Only used when VITE_CATALOG_API_URL is empty (frontend-only demo mode).
# These values are bundled into client JS, so this mode is NOT secure for production.
VITE_ADMIN_EMAIL=admin@domivka.local
VITE_ADMIN_PASSWORD=domivka2026

# Server-side admin credentials for `npm run api` / production Node hosting
ADMIN_EMAIL=admin@domivka.local
ADMIN_PASSWORD=domivka2026
ADMIN_SECRET=change-this-to-a-long-random-secret
PORT=8787
CORS_ORIGIN=http://localhost:5173
